# Magnetic Rush 联机中转服务 · 环境变量
# 安装后位置：/etc/magnetic-rush/relay.env（由 systemd 的 EnvironmentFile 读取）
# 格式：KEY=VALUE 一行一项；# 注释必须单独占一行（不要写在值后面）；值不要加引号、不要留行尾空格。
# 改完执行：sudo systemctl restart magnetic-rush-relay

# 监听端口。走 Nginx / Caddy / cpolar 反代时保持 8080 不变，反代回源到 127.0.0.1:8080。
PORT=8080

# 监听地址（二选一）：
#   0.0.0.0   直接对外：http://<公网IP>:8080 可访问（需要在阿里云安全组 + 本机防火墙放行 8080）
#   127.0.0.1 只给本机反代/隧道回源（推荐；8080 不对公网开放）
HOST=0.0.0.0

# 数据目录：levels.json（自制关卡）、stats.json（运维统计）、accounts.json（后台账号）
# 必须属于服务用户 magnetic-rush 并且可写，否则上传/统计/登录会失败。
DATA_DIR=/var/lib/magnetic-rush

# 后台引导管理员：只在“还没有任何账号”的首次启动时用于创建账号；
# 之后一律以 DATA_DIR/accounts.json 为准，改这里不会改掉已有密码。
# 密码没有默认值，也不允许留空——留空则后台会拒绝访问。
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-please
